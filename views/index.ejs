<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Student Grade CRUD App</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>

<body class="container mt-5">
    <h2 class="mb-4">Student Grade Management (CRUD App)</h2>

    <!-- CREATE FORM -->
    <div class="card p-4 mb-4 shadow-sm">
        <h4>Add New Student</h4>
        <form action="/add" method="POST" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="name" class="form-control" placeholder="Student Name" required>
            </div>
            <div class="col-md-4">
                <input type="text" name="course" class="form-control" placeholder="Course / Program" required>
            </div>
            <div class="col-md-2">
                <input type="number" name="grade" class="form-control" placeholder="Grade" required>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Add</button>
            </div>
        </form>
    </div>

    <!-- READ TABLE -->
    <h4 class="mb-3">Student Records</h4>
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Course</th>
                <th>Grade</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% students.forEach(student => { %>
                <tr>
                    <td>
                        <%= student.name %>
                    </td>
                    <td>
                        <%= student.course %>
                    </td>
                    <td>
                        <%= student.grade %>
                    </td>
                    <td>
                        <a href="/edit/<%= student.id %>" class="btn btn-warning btn-sm">Edit</a>
                        <a href="/delete/<%= student.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">Delete</a>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
</body>

</html>